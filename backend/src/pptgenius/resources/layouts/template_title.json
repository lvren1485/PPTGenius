{
  "type": "title",
  "description": "title_slide / ending — 封面和结尾页的完整元素参考",
  "background": {
    "type": "gradient",
    "gradient_angle": 135,
    "gradient_stops": [
      {"position": 0, "color": "{{primary}}"},
      {"position": 1.0, "color": "{{bg}}"}
    ]
  },
  "elements": [
    {
      "id": "main_title",
      "type": "textbox",
      "position": {"left": 1.0, "top": 2.2, "width": 11.3, "height": 1.5},
      "remark": "主标题 h1",
      "content": [{"paragraph": {"alignment": "left", "runs": [{"text": "标题", "font": {"size": 36, "bold": true, "color": "{{text}}"}}]}}]
    },
    {
      "id": "subtitle",
      "type": "textbox",
      "position": {"left": 1.0, "top": 3.9, "width": 11.3, "height": 0.8},
      "remark": "副标题 body",
      "content": [{"paragraph": {"alignment": "left", "runs": [{"text": "副标题", "font": {"size": 18, "color": "{{text_secondary}}"}}]}}]
    },
    {
      "id": "author_date",
      "type": "textbox",
      "position": {"left": 1.0, "top": 5.0, "width": 5.0, "height": 0.6},
      "remark": "演讲者/日期 caption",
      "content": [{"paragraph": {"alignment": "left", "runs": [{"text": "作者 · 日期", "font": {"size": 14, "color": "{{text_secondary}}"}}]}}]
    },
    {
      "id": "title_accent_bar",
      "type": "shape",
      "shape_type": "rectangle",
      "position": {"left": 0.8, "top": 2.15, "width": 0.08, "height": 1.5},
      "remark": "标题侧边装饰条",
      "fill": {"type": "solid", "color": "{{primary}}"}
    },
    {
      "id": "bottom_accent_bar",
      "type": "shape",
      "shape_type": "rectangle",
      "position": {"left": 0, "top": 6.8, "width": 13.333, "height": 0.7},
      "remark": "底部装饰条",
      "fill": {"type": "solid", "color": "{{primary}}"}
    },
    {
      "id": "icon_decoration",
      "type": "picture",
      "position": {"left": 0.4, "top": 0.4, "width": 0.6, "height": 0.6},
      "remark": "小图标装饰",
      "name": "cpu",
      "color": "{{primary}}",
      "fit": "aspect"
    }
  ]
}
